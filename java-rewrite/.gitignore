# jlink runtime image produced by package.ps1 (recreated on every run, ~100 MB)
.jimg/

# jpackage output (recreated on every run, ~104 MB)
pkgout/

# module paths written by package.ps1; both are machine-specific (absolute .m2 paths)
mp.txt
mp-pkg.txt

# Maven extracted into tools/ (see README "Environment").
# Leading slash anchors it to java-rewrite/tools/ — without it, `tools/`
# would also match src/main/java/com/jello/music/tools/ and silently drop the
# UiProbe / PipelineProbe / PlaybackProbe sources.
/tools/