{
  "name": "jello-music",
  "version": "2.3.0",
  "homepage": "https://github.com/Margele1337/jello-music",
  "main": "electron/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Margele1337/jello-music.git"
  },
  "scripts": {
    "install-all": "npm install && cd api && npm install",
    "postinstall": "node tools/patch-api.cjs",
    "serve": "vite",
    "build": "vite build",
    "build:docker": "cross-env VITE_APP_API_URL=/api vite build",
    "preview": "vite preview",
    "electron:serve": "cross-env NODE_ENV=development node electron/start-electron.cjs",
    "api": "node api/app.js --platform=lite --port=6521",
    "dev": "run-p --race api serve electron:serve",
    "build:api:win": "npm run --prefix ./api pkgwin",
    "electron:build:win": "run-s build:api:win \"electron:build -- --win --publish never\"",
    "electron:build": "cross-env NODE_ENV=production electron-builder"
  },
  "engines": {
    "node": ">=20"
  },
  "build": {
    "publish": {
      "provider": "github",
      "owner": "Margele1337",
      "repo": "jello-music"
    },
    "compression": "normal",
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "build/icons/",
        "to": "icons/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "extraFiles": [
      {
        "from": "api/bin",
        "to": "api/",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "public/assets",
        "to": "assets"
      }
    ],
    "appId": "cn.jello.music",
    "productName": "Jello Music",
    "copyright": "Based on MoeKoe Music (© MoeJue), Jello Music by Margele1337",
    "directories": {
      "output": "dist_electron"
    },
    "asarUnpack": [
      "**/*.node",
      "node_modules/@koromix/**"
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "icon": "build/icons/icon",
    "protocols": [
      {
        "name": "Jello Music Protocol",
        "schemes": [
          "jello"
        ]
      }
    ],
    "win": {
      "icon": "build/icons/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "artifactName": "Jello-Music_Setup_v${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": true,
      "installerIcon": "build/icons/icon.ico",
      "uninstallerIcon": "build/icons/icon.ico",
      "installerHeaderIcon": "build/icons/icon.ico",
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "Jello Music",
      "include": "build/installer.nsh",
      "license": "build/license.txt",
      "language": "2052",
      "warningsAsErrors": true
    },
    "dmg": {
      "sign": false
    }
  },
  "type": "module",
  "author": {
    "name": "Margele1337",
    "email": "xu17183167799@gmail.com"
  },
  "blog": "https://github.com/Margele1337/jello-music",
  "license": "GPL-2.0-only",
  "description": "Jello Music（酷狗音乐第三方播放器，基于 MoeKoe Music 的魔改版）",
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vue/compiler-sfc": "^3.5.12",
    "cross-env": "^7.0.3",
    "electron": "^38.8.6",
    "electron-builder": "^25.1.8",
    "esbuild": "0.25.11",
    "npm-run-all": "^4.1.5",
    "sass-embedded": "^1.99.0",
    "vite": "^7.2.6",
    "vite-plugin-pwa": "^1.2.0",
    "vue-loader": "^17.3.1",
    "wait-on": "^8.0.1"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "axios": "^1.13.2",
    "electron-is-dev": "^3.0.1",
    "electron-log": "^5.2.0",
    "electron-store": "^10.0.0",
    "electron-updater": "^6.6.2",
    "koffi": "^3.3.1",
    "music-metadata": "^11.7.3",
    "pinia": "^3.0.0",
    "pinia-plugin-persistedstate": "^4.1.1",
    "tree-kill": "^1.2.2",
    "uiohook-napi": "^1.5.5",
    "vue": "^3.5.12",
    "vue-i18n": "^10.0.4",
    "vue-router": "^4.4.5",
    "vue3-virtual-scroller": "^0.2.3",
    "ws": "^8.18.1"
  }
}
