{
  "name": "jello-music",
  "version": "0.1.0",
  "private": true,
  "description": "Jello Music - clean-room MIT desktop client",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "install-all": "npm install && npm --prefix api install",
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "start": "electron .",
    "preview": "vite preview",
    "test": "node --test",
    "predist": "node tools/clean-electron-default-app.cjs",
    "dist": "npm run build && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "electron-store": "^12.0.0",
    "electron-updater": "^6.8.12",
    "koffi": "^3.3.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "pinia": "^3.0.4",
    "vite": "^8.3.5",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "cn.jello.music",
    "productName": "Jello Music",
    "icon": "build/icon.ico",
    "electronDist": "node_modules/electron/dist",
    "asarUnpack": [
      "node_modules/koffi/**",
      "node_modules/@koromix/**"
    ],
    "afterPack": "tools/verify-pack.cjs",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "LICENSE",
      "NOTICE"
    ],
    "extraResources": [
      {
        "from": "electron/sidecar-entry.cjs",
        "to": "sidecar-entry.cjs"
      },
      {
        "from": "electron/sidecar-guard.cjs",
        "to": "sidecar-guard.cjs"
      },
      {
        "from": "api",
        "to": "api",
        "filter": [
          "**/*",
          "!node_modules/**",
          "!docs/**",
          "!bin/**",
          "!.git/**",
          "!**/*.md",
          "!**/*.ts",
          "!package-lock.json",
          "!pnpm-lock.yaml"
        ]
      },
      {
        "from": "api/node_modules",
        "to": "api/node_modules",
        "filter": [
          "**/*",
          "!**/.cache/**",
          "!.bin/**"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Jello-Music-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Margele1337",
        "repo": "jello-music"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
